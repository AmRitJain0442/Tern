    },
    {
      "id": "strong",
      "provider": "openrouter",
      "upstream_model": "google/gemini-2.5-pro",
      "tier": "strong",
      "context_length": 32768,
      "max_output_tokens": 4096,
      "supported_parameters": ["max_tokens", "temperature", "tools", "tool_choice", "response_format", "structured_outputs"]
    }
  ]
}
