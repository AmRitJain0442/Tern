{
  "providers": {
    "compatible": {
      "type": "openai_compatible",
      "base_url": "https://YOUR_PROVIDER_HOST/v1",
      "api_key_env": "ECONOMY_PROVIDER_KEY",
      "token_parameter": "max_tokens"
    },
    "openrouter": {
      "type": "openrouter",
      "base_url": "https://openrouter.ai/api/v1",
      "api_key_env": "OPENROUTER_API_KEY"
    }
  },
  "models": [
    {
      "id": "economy",
      "provider": "compatible",
      "upstream_model": "YOUR_ECONOMY_MODEL",
      "tier": "economy",
      "context_length": 16384,
      "max_output_tokens": 4096,
      "supported_parameters": ["max_tokens"]
    },
    {
      "id": "strong",
      "provider": "openrouter",
      "upstream_model": "google/gemini-2.5-pro",
      "tier": "strong",
      "context_length": 32768,
      "max_output_tokens": 4096,
      "supported_parameters": ["max_tokens", "temperature", "tools", "tool_choice", "response_format", "structured_outputs"]
    }
  ]
}
