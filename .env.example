OPENROUTER_API_KEY=
OPENROUTER_ECONOMY_MODEL=google/gemini-2.5-flash-lite
OPENROUTER_STRONG_MODEL=google/gemini-2.5-pro
LAYA_ENDPOINT=http://127.0.0.1:8080
LAYA_AUTH=auto

# Optional: provider definitions; model/provider keys are referenced by environment name.
# Native and Compose paths both resolve this under the repository/app directory.
# TERN_CONFIG=config/providers.json
# Optional bearer key for Tern's /v1/chat/completions and /v1/models endpoints.
# TERN_API_KEY=choose-your-own-server-key
# Set only when the server's incoming text is known to be English.
# TERN_DEFAULT_LANGUAGE=en
