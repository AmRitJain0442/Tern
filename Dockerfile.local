# Local onboarding: packages in the image, pinned weights in a reusable named volume.
FROM python:3.12-slim-bookworm
RUN apt-get update && apt-get install -y --no-install-recommends git libopenblas0 liblapack3 \
    && rm -rf /var/lib/apt/lists/*
COPY --from=ghcr.io/astral-sh/uv:0.7.13 /uv /usr/local/bin/uv
WORKDIR /app
COPY pyproject.toml uv.lock README.md LICENSE THIRD_PARTY_NOTICES.md ./
COPY src ./src
ARG MLX_EXTRA=mlx-cpu
RUN uv sync --frozen --extra cli --extra ${MLX_EXTRA} --no-dev --no-editable
RUN useradd --uid 10001 --create-home router \
    && mkdir -p /models /app/artifacts && chown router:router /models /app/artifacts
ENV PATH="/app/.venv/bin:$PATH" MODEL_PATH=/models/laya-mlx \
    HF_HOME=/models/huggingface TOKENIZERS_PARALLELISM=false \
    MLX_DEVICE=cpu MLX_DTYPE=float32 OPENBLAS_NUM_THREADS=2 OMP_NUM_THREADS=2 \
    ROUTER_MODE=shadow PYTHONUNBUFFERED=1 LAYA_ENDPOINT=http://127.0.0.1:8080 LAYA_AUTH=local
USER router
EXPOSE 8080
CMD ["python", "-m", "model_router.local_service"]
